set nocompatible

filetype on
filetype plugin on
filetype indent on
syntax on

set number
set relativenumber
set cursorline

set ignorecase
set smartcase
set showmode
set hlsearch
set wildmenu
set ruler
set lazyredraw

set t_Co=256
set encoding=utf8

set expandtab
set smarttab

set shiftwidth=4
set tabstop=4
